<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <radialGradient id="bg" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#1a2840"/>
      <stop offset="100%" stop-color="#080c12"/>
    </radialGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#00d4ff" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#00d4ff" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <!-- Background -->
  <rect width="400" height="400" fill="url(#bg)"/>
  <!-- Glow -->
  <ellipse cx="200" cy="160" rx="140" ry="120" fill="url(#glow)"/>
  <!-- Outer ring -->
  <circle cx="200" cy="200" r="190" fill="none" stroke="#1e2d3d" stroke-width="1"/>
  <circle cx="200" cy="200" r="188" fill="none" stroke="#00d4ff" stroke-width="1.5" stroke-dasharray="8 4" opacity="0.4"/>
  <!-- Avatar circle -->
  <circle cx="200" cy="165" r="80" fill="#111720" stroke="#2a3f55" stroke-width="1.5"/>
  <!-- Face silhouette -->
  <circle cx="200" cy="150" r="42" fill="#1e2d3d"/>
  <ellipse cx="200" cy="215" rx="62" ry="30" fill="#1e2d3d"/>
  <!-- Initials -->
  <text x="200" y="163" font-family="Space Grotesk, Arial, sans-serif" font-size="36" font-weight="700" fill="#00d4ff" text-anchor="middle" dominant-baseline="middle">EM</text>
  <!-- Bottom label -->
  <rect x="80" y="300" width="240" height="48" rx="8" fill="#111720" stroke="#1e2d3d" stroke-width="1"/>
  <text x="200" y="318" font-family="Arial, sans-serif" font-size="13" font-weight="600" fill="#f0f4f8" text-anchor="middle">Ephy Mshindi</text>
  <text x="200" y="336" font-family="Arial, sans-serif" font-size="11" fill="#6b7d8f" text-anchor="middle">MshindiSecure · Nairobi, KE</text>
  <!-- Cyan accent dot -->
  <circle cx="200" cy="268" r="4" fill="#00d4ff" opacity="0.8"/>
  <circle cx="200" cy="268" r="8" fill="none" stroke="#00d4ff" stroke-width="1" opacity="0.3"/>
</svg>
